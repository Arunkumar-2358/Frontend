# Where the web server reaches the API (server-to-server; never exposed to the browser).
API_URL="http://localhost:4000"

# Must equal the API's SESSION_SECRET: middleware verifies the session JWT the API issues.
SESSION_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# Web push public key (same value as the API's VAPID_PUBLIC_KEY). Build-time, public.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
