# Where the web server reaches the API (server-to-server; never exposed to the browser).
API_URL="http://localhost:4000"

# REQUIRED. Must equal the API's SESSION_SECRET: middleware verifies the access JWT (HS256) the API issues.
# There is no fallback — if it is missing or different, every request is treated as signed out.
SESSION_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# Web push public key (same value as the API's VAPID_PUBLIC_KEY). Build-time, public.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""

# Optional error reporting (Sentry). Leave empty to disable completely — nothing is loaded or sent.
# SENTRY_DSN is read at runtime by the server; NEXT_PUBLIC_SENTRY_DSN is baked in at build time for the browser.
# Events are PII-scrubbed (no cookies, headers, bodies or query strings). No auth token / source-map upload needed.
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
# NEXT_PUBLIC_SENTRY_ENVIRONMENT="production"
# NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE="0"
